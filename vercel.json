{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "MenuKasir",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://projectmenu-seven.vercel.app",
    "APP_KEY": "base64:mZW8LvAMd0FD87Asog62OJXjMWi8l8JOEnAuOdW4pZk=",
    "APP_MAINTENANCE_DRIVER": "file",
    "LOG_CHANNEL": "stderr",
    "APP_STORAGE": "/tmp/storage",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "SESSION_DRIVER": "database",
    "SESSION_LIFETIME": "120",
    "SESSION_COOKIE": "menukasir_session",
    "CACHE_STORE": "database",
    "HASH_DRIVER": "bcrypt",
    "BCRYPT_ROUNDS": "12",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_DATABASE": "test",
    "DB_USERNAME": "3XEwmR5XCJCtCyk.root",
    "DB_PASSWORD": "K0JXep8hB9kQNrlv"
  }
}
